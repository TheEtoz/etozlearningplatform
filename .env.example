# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it contains secrets.

# Backend
APP_NAME=ETOZ Learning Platform
# Production: set DEBUG=False
DEBUG=True
# Production: required — long random string (never leave the default).
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL connection used by SQLAlchemy and Alembic.
# Use 127.0.0.1 instead of localhost on Windows to avoid slow IPv6 lookups.
# Neon example:
# DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx.neon.tech/etoz_db?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/etoz_db

# Comma-free JSON list of usernames that become admins on register.
ADMIN_USERNAMES=["teacher"]

# Rate limits (enforced when DEBUG=False)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Docker code execution
DOCKER_IMAGE=etoz-python-runner
DOCKER_MEMORY_LIMIT=128m
DOCKER_CPU_LIMIT=0.5
DOCKER_TIMEOUT_SECONDS=10

# Frontend
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=8501
# Public Streamlit URL used in verify / reset email links (no trailing slash).
FRONTEND_PUBLIC_URL=http://localhost:8501

# Email (required in production: Resend OR SMTP). With DEBUG=True and neither set,
# verify/reset links are printed to the API log instead of sent.
EMAIL_FROM=ETOZ <noreply@yourdomain.com>
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
EMAIL_VERIFY_EXPIRE_HOURS=24
EMAIL_RESET_EXPIRE_HOURS=1

# Uploaded lecture/question media (local folder for MVP).
MEDIA_ROOT=media
PUBLIC_API_URL=http://127.0.0.1:8000
MEDIA_MAX_UPLOAD_MB=40

# Public demo mode (v2): skip login; anyone can view/play public classes.
# Progress/quiz attempts are graded but not saved.
PUBLIC_MODE=true
# Optional preferred class id for the homepage (else first public class).
# PUBLIC_CLASS_ID=1

# JSON array of browser origins allowed to call FastAPI.
# Production: include your Streamlit Cloud URL.
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
